# Example terraform.tfvars - Copy this to terraform.tfvars and customize

# AWS Configuration
# aws_region     = "eu-west-3"
# aws_account_id = "963275461308"

# Project Configuration
# project_name = "eo-agent"
# environment  = "production"

# GitHub Repository for OIDC
# github_repository = "your-org/your-repo"

# VPC Configuration
# vpc_cidr             = "10.1.0.0/16"
# availability_zones   = ["eu-west-3a", "eu-west-3b", "eu-west-3c"]
# public_subnet_cidrs  = ["10.1.1.0/24", "10.1.2.0/24", "10.1.3.0/24"]

# MCP Server Configuration
# mcp_server_cpu           = "4096"
# mcp_server_memory        = "8192"
# mcp_server_desired_count = 1
# mcp_log_level            = "info"
# mcp_workers              = "1"

# Streamlit Configuration
# streamlit_cpu           = "4096"
# streamlit_memory        = "8192"
# streamlit_desired_count = 1

# Service Discovery
# service_discovery_namespace = "eo-agent.local"

# Secrets (ARNs from AWS Secrets Manager)
# opentopo_api_key_arn = "arn:aws:secretsmanager:eu-west-3:963275461308:secret:mpllm/api-keys/OPENTOPO_API_KEY-z1pBzv"
# map_key_arn          = "arn:aws:secretsmanager:eu-west-3:963275461308:secret:mpllm/api-keys/MAP_KEY-GUFKLE"
# maptiler_api_key_arn = ""  # Optional, leave empty if not using
# bdtopo_database_url_secret_arn = "arn:aws:secretsmanager:...:secret:.../BDTOPO_DATABASE_URL-xxxx"

# Cognito / Authentication (shared by Agent Server and Streamlit)
# Public identifiers are injected as plain env vars; the Streamlit app client
# secret is read from Secrets Manager (JSON key COGNITO_CLIENT_SECRET).
# auth_enabled                = "true"
# agent_auth_providers        = "cognito"
# cognito_region              = "eu-west-3"
# cognito_user_pool_id        = "eu-west-3_xxxxxxxxx"
# cognito_domain              = "https://eu-west-3xxxxxxxxx.auth.eu-west-3.amazoncognito.com"
# cognito_app_client_id       = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
# cognito_token_use           = ""          # "access" or "id"; empty skips the check
# cognito_jwt_leeway_seconds  = "0"
# cognito_redirect_uri        = "https://<your-alb-or-domain>/"
# cognito_logout_redirect_uri = "https://<your-alb-or-domain>/"
# cognito_scopes              = "openid email profile"
# cognito_client_secret_arn   = "arn:aws:secretsmanager:eu-west-3:963275461308:secret:mpllm/auth/COGNITO_CLIENT_SECRET-xxxxxx"

# GeoServer Configuration
# geoserver_base_url   = "http://geoserver-alb-556624184.eu-west-3.elb.amazonaws.com/geoserver"
# geoserver_risk_layer = "georisk:predictions"

# Fire Archive
# fire_archive_dir = "s3://metaplanet-fire-archive-firms/"

# Managed PostGIS for full-France BDTOPO (recommended for low-latency agent queries)
# postgis_enabled                 = true
# postgis_instance_class          = "db.r6g.xlarge"
# postgis_allocated_storage       = 500
# postgis_max_allocated_storage   = 2000
# postgis_multi_az                = false
# postgis_backup_retention_period = 7
# postgis_db_name                 = "bdtopo"
# postgis_master_username         = "bdtopo_admin"
# postgis_deletion_protection     = true

# BDTOPO ingestion pipeline (ECS Fargate batch task + EventBridge quarterly schedule)
# Requires bdtopo_database_url_secret_arn to be set above.
# bdtopo_pipeline_enabled               = true
# bdtopo_pipeline_cpu                   = "4096"
# bdtopo_pipeline_memory                = "16384"
# bdtopo_pipeline_ephemeral_storage_gib = 100
# bdtopo_pipeline_schedule_enabled      = true
