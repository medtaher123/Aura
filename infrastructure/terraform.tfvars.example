# Example terraform.tfvars - Copy this to terraform.tfvars and customize

# AWS Configuration
# aws_region     = "eu-west-3"
# aws_account_id = "637423200916"

# Project Configuration
# project_name = "mpllm"
# environment  = "production"

# VPC Configuration
# vpc_cidr             = "10.0.0.0/16"
# availability_zones   = ["eu-west-3a", "eu-west-3b", "eu-west-3c"]
# public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]

# MCP Server Configuration
# mcp_server_cpu           = "256"
# mcp_server_memory        = "512"
# mcp_server_desired_count = 1
# mcp_server_image         = "637423200916.dkr.ecr.eu-west-3.amazonaws.com/mpllm-mcp:latest"

# MCP Server Environment
# mcp_server_log_level = "info"
# mcp_server_workers   = "1"

# Agent Server Configuration
# agent_server_enabled          = true
# agent_server_cpu              = "512"
# agent_server_memory           = "1024"
# agent_server_desired_count    = 1
# agent_server_log_level        = "info"
# agent_server_workers          = "1"
# agent_server_mcp_server_url   = "http://localhost:8000"
# agent_server_bedrock_model_id = "anthropic.claude-3-5-sonnet-20241022-v2:0"
# agent_server_bedrock_max_tokens = "4096"

# Secrets (ARNs from AWS Secrets Manager)
# opentopo_api_key_arn = "arn:aws:secretsmanager:eu-west-3:637423200916:secret:mpllm/api-keys/OPENTOPO_API_KEY-z1pBzv"
# map_key_arn          = "arn:aws:secretsmanager:eu-west-3:637423200916:secret:mpllm/api-keys/MAP_KEY-GUFKLE"
