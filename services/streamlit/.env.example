MAPTILER_API_KEY=
FIRE_ARCHIVE_DIR=
AGENT_SERVER_URL=ws://localhost:8080

# ---------------------------------------------------------------------------
# Cognito Hosted UI login (OAuth2 authorization code flow)
# ---------------------------------------------------------------------------
# When COGNITO_DOMAIN and COGNITO_CLIENT_ID are set, Streamlit redirects users
# to the Cognito Hosted UI and forwards the resulting access token to the
# Agent Server. Leave these empty to disable the login gate (local dev).
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
# Only required for confidential app clients (those with a client secret):
COGNITO_CLIENT_SECRET=
# Must exactly match an allowed callback URL on the Cognito app client:
COGNITO_REDIRECT_URI=http://localhost:8501
COGNITO_SCOPES=openid email profile
# Must match an allowed sign-out URL on the Cognito app client:
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:8501
# Optional override: "true"/"false" to force the login gate on/off.
COGNITO_AUTH_ENABLED=

