# MCP Server Local Development Environment Variables
# TEMPLATE FILE - Copy to .env and fill in your values

# Application Settings
LOG_LEVEL=debug
DEBUG=false
WORKERS=1

# API Keys (REQUIRED - Get from team/AWS Secrets Manager)
OPENTOPO_API_KEY=<your_opentopo_api_key_here>
MAP_KEY=<your_nasa_firms_map_key_here>

# Web search (optional; DuckDuckGo/ddgs is used when neither key is set)
# TAVILY_API_KEY=<your_tavily_api_key_here>
# BRAVE_API_KEY=<your_brave_api_key_here>

# GeoServer Configuration
GEOSERVER_BASE_URL=http://geoserver-alb-556624184.eu-west-3.elb.amazonaws.com/geoserver
GEOSERVER_RISK_LAYER=georisk:predictions

# Fire Detection
FIRE_ARCHIVE_DIR=./fire_archive

# GDFC drought/flood hazard (public S3 - optional for drought_flood_risk_tool)
# GDFC_DROUGHT_S3=s3://global-drought-flood-catalogue/Hazard-Maps/Drought-Frequency/
# GDFC_FLOOD_S3=s3://global-drought-flood-catalogue/Hazard-Maps/Pluvial-Frequency/

# BDTOPO PostGIS (optional; required to enable bdtopo_query_tool)
# Password special characters in URLs must be percent-encoded (e.g. ? -> %3F).
# BDTOPO_DATABASE_URL=postgresql://user:password@host:5432/bdtopo
# BDTOPO_QUERY_TIMEOUT_SECONDS=30
# BDTOPO_DEFAULT_RADIUS_M=5000
# Browser-reachable pg_tileserv for TerraZard / optional BDTOPO overlays
# BDTOPO_TILE_SERVER_URL=http://localhost:7801
# Optional tileserv DB override when AWS RDS is unreachable from Docker:
# BDTOPO_TILESERV_DATABASE_URL=postgresql://bdtopo:bdtopo@bdtopo-postgis:5432/bdtopo

# Browser-reachable base URL for MapLibre style JSON served by MCP (/styles/*.json).
# Leave empty for path-absolute URLs (/styles/plan_ign_standard.json); Streamlit
# falls back to local static copies under services/streamlit/static/map_styles/.
# MAP_STYLES_BASE_URL=http://localhost:8000




#TERRAZARD
TERRAZARD_DATABASE_USER=admin_terrazard
TERRAZARD_DATABASE_PASSWORD=
TERRAZARD_DATABASE_HOST=
TERRAZARD_DATABASE_DB=hazard_archive
TERRAZARD_DATABASE_PORT=5432
TERRAZARD_DATABASE_URL=postgresql://${TERRAZARD_DATABASE_USER}:${TERRAZARD_DATABASE_PASSWORD}@${TERRAZARD_DATABASE_HOST}:${TERRAZARD_DATABASE_PORT}/${TERRAZARD_DATABASE_DB}  

DATABASE_URL=postgresql://${TERRAZARD_DATABASE_USER}:${TERRAZARD_DATABASE_PASSWORD}@${TERRAZARD_DATABASE_HOST}:${TERRAZARD_DATABASE_PORT}/${TERRAZARD_DATABASE_DB}
TERRAZARD_TILE_SERVER_URL=http://localhost:7800
TERRAZARD_DEFAULT_MODEL=flood80