# MCP Server Local Development Environment Variables
# TEMPLATE FILE - Copy to .env and fill in your values

# Application Settings
LOG_LEVEL=debug
WORKERS=1

# API Keys (REQUIRED - Get from team/AWS Secrets Manager)
OPENTOPO_API_KEY=<your_opentopo_api_key_here>
MAP_KEY=<your_nasa_firms_map_key_here>

# GeoServer Configuration
GEOSERVER_BASE_URL=http://geoserver-alb-556624184.eu-west-3.elb.amazonaws.com/geoserver
GEOSERVER_RISK_LAYER=georisk:predictions

# Fire Detection
FIRE_ARCHIVE_DIR=./fire_archive
